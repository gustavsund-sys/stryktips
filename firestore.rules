rules_version = '2';
service cloud.firestore {
  function isTipsAdmin() {
    return request.auth != null && request.auth.token.email == 'tstipset@gmail.com';
  }
  match /databases/{database}/documents {
    match /stryktipset/{document} { allow read: if true; allow write: if false; }
    match /rounds/{document} { allow read: if true; allow write: if false; }
    match /scrapeRuns/{document} { allow read, write: if false; }
    match /systemStatus/{document} { allow read: if true; allow write: if false; }
    match /expertStats/{document} { allow read: if true; allow write: if false; }
    match /claimRounds/{document} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isTipsAdmin() && request.time < resource.data.lockAt && (
        (resource.data.status == 'unclaimed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'participant', 'claimedAt'])
          && request.resource.data.status == 'claimed'
          && request.resource.data.participant in ['Jocke', 'Tony', 'Gustav', 'Anders', 'Matta-Råsnygg', 'Christer']
          && request.resource.data.claimedAt == request.time)
        ||
        (resource.data.status == 'claimed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'participant', 'challengers', 'base', 'originalTips', 'finalTips', 'rows', 'cost', 'lockedAt'])
          && request.resource.data.status == 'locked'
          && request.resource.data.participant in ['Jocke', 'Tony', 'Gustav', 'Anders', 'Matta-Råsnygg', 'Christer']
          && request.resource.data.base in ['expert', 'chaparral']
          && request.resource.data.originalTips is list && request.resource.data.originalTips.size() == 13
          && request.resource.data.finalTips is list && request.resource.data.finalTips.size() == 13
          && request.resource.data.rows is int && request.resource.data.rows > 0 && request.resource.data.rows <= 300
          && request.resource.data.cost == request.resource.data.rows
          && request.resource.data.lockedAt == request.time)
        ||
        (resource.data.status == 'locked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'participant', 'challengers', 'base', 'originalTips', 'finalTips', 'rows', 'cost', 'lockedAt', 'unlockedAt'])
          && request.resource.data.status == 'claimed'
          && request.resource.data.participant in ['Jocke', 'Tony', 'Gustav', 'Anders', 'Matta-Råsnygg', 'Christer']
          && !request.resource.data.keys().hasAny(['base', 'originalTips', 'finalTips', 'rows', 'cost', 'lockedAt'])
          && request.resource.data.unlockedAt == request.time)
        ||
        (resource.data.status == 'locked'
          && request.resource.data.status == 'locked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengers'])
          && request.resource.data.challengers is map
          && request.resource.data.challengers.size() <= 5)
      );
    }
    match /aliasReviews/{document} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isTipsAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && request.resource.data.candidates == resource.data.candidates;
    }
    match /teamAliases/{document} {
      allow read, delete: if false;
      allow create, update: if isTipsAdmin()
        && request.resource.data.keys().hasOnly(['alias', 'canonical', 'approvedAt', 'approvedBy'])
        && request.resource.data.alias is string
        && request.resource.data.canonical is string
        && request.resource.data.alias.size() > 0
        && request.resource.data.alias.size() <= 80
        && request.resource.data.canonical.size() > 0
        && request.resource.data.canonical.size() <= 80
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.approvedBy == request.auth.token.email;
    }
  }
}
